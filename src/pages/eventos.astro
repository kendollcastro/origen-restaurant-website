---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { site, waLink } from '../data/site';
import { ambiente, bebidas, platos } from '../data/photos';
import type { ImageMetadata } from 'astro';

const waHref = waLink('Hola Origen, quisiera cotizar un evento.');
const hour12 = (t: string) => Number(t.slice(0, 2)) % 12 || 12;
const period = (t: string) => (Number(t.slice(0, 2)) >= 12 ? 'pm' : 'am');
// Fotografías provisionales de la galería (P-16): se reemplazan al llegar las tomas de eventos.
const tipos: [string, string, string, string, ImageMetadata][] = [
  ['Grupos de tour', 'grupo de tour', 'Trabajamos con tour operadores de Jacó. Almuerzos y cenas para grupos con menú fijo y servicio ágil.', 'Mesa puesta para un grupo de tour en Origen.', platos[9]],
  ['Cumpleaños y aniversarios', 'cumpleaños', 'Mesas privadas o el salón completo.', 'Celebración de cumpleaños en el salón de Origen.', bebidas[3]],
  ['Empresas', 'cena corporativa', 'Cenas de equipo, fiestas de fin de año y reuniones con menú cerrado y factura electrónica.', 'Cena de equipo servida en el salón de Origen.', bebidas[4]],
  ['Bodas y ensayos', 'boda', 'Cenas de ensayo y recepciones íntimas a pasos de la playa de Jacó.', 'Cena de ensayo de boda, a pasos de la playa de Jacó.', platos[10]],
];
---
<Base
  title="Eventos y grupos en Jacó · Origen — hasta 120 invitados"
  description={`Celebra en Origen, Jacó: grupos de tour, cumpleaños, cenas de empresa y bodas. Capacidad para ${site.capacity} invitados y menú a la medida. Cotiza por WhatsApp.`}
>
  <PageHero crumb="Eventos" script="Celebra en Jacó" title="Eventos y grupos" photo="mesa larga montada para evento" src={ambiente[7]}
    lead={`Mariscos y parrilla en Jacó, con capacidad para hasta ${site.capacity} invitados, menú a la medida y un equipo con experiencia en grupos y tours. Abrimos todos los días, de 11:00 am a 10:00 pm.`}>
    <a href="#cotizar" class="btn btn-primary" style="margin-top: 12px;">Cotizar mi evento</a>
  </PageHero>

  <section class="container section stack" style="gap: 48px;" aria-labelledby="tipos-t">
    <h2 id="tipos-t" class="display reveal" style="text-align: center;">¿Qué celebramos contigo?</h2>
    <div class="grid reveal" data-stagger style="--min: 260px;">
      {tipos.map(([t, photo, d, alt, src]) => (
        <article class="stack" style="gap: 14px;">
          <Photo label={photo} alt={alt} src={src} height="300px" />
          <h3 style="font-family: var(--serif); font-weight: 600; font-size: 30px; line-height: 1.1;">{t}</h3>
          <p style="color: var(--soft);">{d}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="light">
    <div class="container grid reveal" style="--min: 220px; --gap: 32px; padding-block: 80px; text-align: center;">
      {[
        [String(site.capacity), 'invitados de capacidad'],
        [`${hour12(site.hours.opens)}–${hour12(site.hours.closes)}`, `abierto de ${hour12(site.hours.opens)} ${period(site.hours.opens)} a ${hour12(site.hours.closes)} ${period(site.hours.closes)}`],
      ].map(([n, l]) => (
        <div class="stack" style="gap: 4px;">
          <span style="font-family: var(--serif); font-weight: 600; font-size: 64px; line-height: 1;">{n}</span>
          <span class="label" style="color: var(--ink-muted);">{l}</span>
        </div>
      ))}
      <!-- Menús para grupos: pendiente (P-09 → T-23), se oculta hasta el dato real (política §6). -->
    </div>
  </section>

  <section id="cotizar" class="container section row" style="align-items: flex-start;" aria-labelledby="cot-t">
    <div class="stack reveal" style="flex: 1 1 380px; gap: 14px;">
      <span class="script">Hablemos</span>
      <h2 id="cot-t" class="display">Cotiza tu evento</h2>
      <p class="lead">Cuéntanos la fecha y el número de personas. Te respondemos por WhatsApp o correo con una propuesta de menú.</p>
      <p class="muted" style="font-size: 14px;">WhatsApp {site.phone}<br />{site.email}</p>
      <p class="dim">Mientras tanto, mira el <a href="/menu/">menú</a>, conoce a <a href="/nosotros/">nuestro equipo</a> o encuéntranos en <a href="/contacto/">contacto</a>.</p>
    </div>
    <form id="event-form" class="form reveal" style="flex: 2 1 560px; --reveal-delay:.12s" data-wa={site.whatsapp} action={waHref} method="get" target="_blank">
      <div class="field"><label for="e-n">Nombre</label><input id="e-n" name="nombre" type="text" autocomplete="name" required /></div>
      <div class="field"><label for="e-w">WhatsApp</label><input id="e-w" name="tel" type="tel" autocomplete="tel" /></div>
      <div class="field">
        <label for="e-t">Tipo de evento</label>
        <select id="e-t" name="tipo"><option>Grupo de tour</option><option>Cumpleaños / aniversario</option><option>Empresa</option><option>Boda / ensayo</option><option>Otro</option></select>
      </div>
      <div class="field"><label for="e-p">Número de invitados</label><input id="e-p" name="invitados" type="number" min="1" max={site.capacity} required /></div>
      <div class="field"><label for="e-d">Fecha</label><input id="e-d" name="fecha" type="date" required /></div>
      <div class="field"><label for="e-e">Correo</label><input id="e-e" name="correo" type="email" autocomplete="email" /></div>
      <div class="field full"><label for="e-m">Detalles</label><textarea id="e-m" name="detalles" rows="4"></textarea></div>
      <button type="submit" class="btn btn-primary full" style="height: 54px;">Solicitar cotización por WhatsApp</button>
      <noscript class="full">
        <p class="dim">Sin JavaScript, ingresa al menos WhatsApp o correo y <a href={waHref}>envía la cotización por WhatsApp</a> con el tipo de evento, la fecha y el número de invitados.</p>
      </noscript>
    </form>
  </section>
</Base>

<script>
  const hoyEnCR = () => {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Costa_Rica',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date());
    const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
    return `${get('year')}-${get('month')}-${get('day')}`;
  };
  const date = document.getElementById('e-d') as HTMLInputElement | null;
  if (date) date.min = hoyEnCR();
  const form = document.getElementById('event-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    const d = new FormData(form);
    const tel = String(d.get('tel') || '').trim();
    const correo = String(d.get('correo') || '').trim();
    if (tel === '' && correo === '') {
      e.preventDefault();
      alert('Ingresa al menos un canal de contacto: WhatsApp o correo.');
      return;
    }
    e.preventDefault();
    const msg = [
      'Hola Origen, quisiera cotizar un evento:',
      `• Nombre: ${d.get('nombre')}`,
      `• Tipo: ${d.get('tipo')}`,
      `• Invitados: ${d.get('invitados')}`,
      `• Fecha: ${d.get('fecha')}`,
      tel ? `• WhatsApp: ${tel}` : '',
      correo ? `• Correo: ${correo}` : '',
      d.get('detalles') ? `• Detalles: ${d.get('detalles')}` : '',
    ].filter(Boolean).join('\n');
    window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
  });
</script>
