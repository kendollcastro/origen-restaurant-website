---
import Base from '../layouts/Base.astro';
import OpenTableWidget from '../components/OpenTableWidget.astro';
import { site, telHref } from '../data/site';
import { faqs } from '../data/faq';
import { isReal, isRealPhone } from '../data/placeholders';

// Solo se publican las FAQ con pregunta y respuesta reales (política §6); las pendientes
// quedan en faq.ts como shot list hasta T-21. Si no hay ninguna, se oculta la sección y el FAQPage.
// Además se excluyen respuestas que incrustan el teléfono mientras siga pendiente (T-40):
// evita publicar/basar el FAQPage en '+506 0000 0000' (placeholder sin corchetes).
const phonePending = !isRealPhone(site.phone);
const publicFaqs = faqs.filter((f) => isReal(f.q) && isReal(f.a) && !(phonePending && f.a.includes(site.phone)));
const faqSchema = publicFaqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: publicFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : undefined;
---
<Base
  title="Reservas y contacto · Origen Jacó — horario y ubicación"
  description={`Reserva en línea en Origen, Jacó. Dirección, horario (${site.hours.label}), cómo llegar y respuestas a las preguntas más frecuentes.`}
  schema={faqSchema}
>
  <section class="container stack reveal" style="padding-block: 88px 40px; gap: 12px;">
    <nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">Contacto</span></nav>
    <span class="script" style="font-size: 40px;">Te esperamos</span>
    <h1 class="display" style="font-size: clamp(44px, 6vw, 72px);">Reservas y contacto</h1>
    <p class="lead" style="max-width: 640px;">Mariscos y parrilla en Jacó, Costa Rica. Abrimos todos los días, de 11:00 am a 10:00 pm. Reserva en línea.</p>
  </section>

  <section id="reservar" class="container row" style="padding-bottom: 100px; align-items: flex-start; gap: 48px; scroll-margin-top: 24px;">
    <div class="stack reveal" style="flex: 1 1 380px; gap: 28px;">
      <address class="stack" style="font-style: normal; gap: 4px;">
        <h2 class="label">Dirección</h2>
        <p style="font-size: 18px;">{site.fullName}<br />{isReal(site.address.street) && <>{site.address.street}<br /></>}{site.address.locality}, {site.address.county}, {site.address.region}, {site.address.countryName}</p>
        <span>
          <a href={site.mapsUrl} class="link-caps" target="_blank" rel="noopener">Google Maps</a> ·
          <a href={site.wazeUrl} class="link-caps" target="_blank" rel="noopener">Waze</a>
        </span>
      </address>
      <div class="stack" style="gap: 4px;">
        <h2 class="label">Horario</h2>
        <p style="font-size: 18px;">{site.hours.days}<br />{site.hours.label}</p>
      </div>
      <div class="stack" style="gap: 4px;">
        <h2 class="label">Contacto</h2>
        <p style="font-size: 18px;">
          <a href={telHref(site.phone)}>{site.phone}</a><br />
          <a href={`https://wa.me/${site.whatsapp}`}>WhatsApp</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
    <div class="reveal stack" style="flex: 1 1 520px; gap: 18px; --reveal-delay:.12s">
      <h2 class="display" style="font-size: 36px;">Reserva tu mesa</h2>
      <div style="padding: 18px 18px 14px; background: rgba(242,235,221,.04); border: 1px solid rgba(242,235,221,.08); width: fit-content;">
        <OpenTableWidget lang="es" />
      </div>
      <p class="dim">¿Prefieres WhatsApp? <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">Escríbenos</a> · {site.phone}</p>
      <p class="dim" style="margin-top: -8px;">Para grupos de más de {site.reservationMax} personas, visita <a href="/eventos/">Eventos y grupos</a>.</p>
      <p class="dim">¿Primera vez? Mira el <a href="/menu/">menú</a> y conoce <a href="/nosotros/">nuestra historia</a>.</p>
    </div>
  </section>

  <div id="mapa" class="map-frame" style="width: 100%; height: 420px;">
    <iframe src={site.mapEmbed} title="Ubicación de Origen en Jacó, Costa Rica — Google Maps" width="100%" height="420" style="border: 0; display: block;" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
  </div>

  {publicFaqs.length > 0 && (
    <section class="light" aria-labelledby="faq-t">
      <div class="container section stack reveal" style="max-width: 920px; gap: 32px;">
        <div class="center" style="gap: 6px; text-align: center;">
          <span class="script">Antes de venir</span>
          <h2 id="faq-t" class="display">Preguntas frecuentes</h2>
        </div>
        <div class="faq">
          {publicFaqs.map((f) => (
            <details>
              <summary><h3>{f.q}</h3><span class="pm" aria-hidden="true">+</span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>
