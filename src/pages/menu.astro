---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import DishList from '../components/DishList.astro';
import OpenTableWidget from '../components/OpenTableWidget.astro';
import { menu } from '../data/menu';
import { site } from '../data/site';
import { platos } from '../data/photos';

// JSON-LD del menú (solo platos confirmados)
const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  '@id': `${site.url}/menu/#menu`,
  name: `Menú de ${site.fullName}`,
  inLanguage: 'es',
  hasMenuSection: menu
    .map((c) => ({
      '@type': 'MenuSection',
      name: c.title,
      hasMenuItem: c.dishes
        .filter((d) => !d.name.startsWith('['))
        .map((d) => ({
          '@type': 'MenuItem',
          name: d.name,
          ...(d.desc ? { description: d.desc } : {}),
          ...(d.price ? { offers: { '@type': 'Offer', price: d.price, priceCurrency: 'CRC' } } : {}),
        })),
    }))
    .filter((s) => s.hasMenuItem.length),
};
---
<Base
  title="Menú · Origen Jacó — Mariscos, cortes y ceviches"
  description="Menú de Origen en Jacó: ceviches, mariscos del Pacífico, cortes a la parrilla, menú de niños y postres. Precios con IVA incluido."
  schema={menuSchema}
>
  <PageHero
    crumb="Menú" script="Nuestro" title="Menú" photo="mesa con platos variados" src={platos[6]}
    lead="Mariscos frescos del Pacífico, cortes a la parrilla y cocina costarricense en Jacó. Precios con IVA incluido. Abrimos todos los días, de 11:00 am a 10:00 pm."
  />

  <nav class="cat-nav" aria-label="Categorías del menú">
    <div class="container">
      {menu.map((c) => <a href={`#${c.id}`}>{c.title}</a>)}
    </div>
  </nav>

  <div class="container menu-cats" style="padding-block: 88px 120px;">
    {menu.map((c, i) => (
      <section id={c.id} class="stack reveal" style={`gap: 6px; --reveal-delay:${i * 0.06}s`} aria-labelledby={`h-${c.id}`}>
        <span class="script" style="font-size: 24px;">{c.kicker}</span>
        <h2 id={`h-${c.id}`} class="display" style="font-size: clamp(32px, 9vw, 46px); margin-bottom: 6px;">{c.title}</h2>
        {c.note && <p class="dim">{c.note}</p>}
        <DishList dishes={c.dishes} />
      </section>
    ))}
  </div>

  <section class="light">
    <div class="container center reveal" style="padding-block: 80px 56px; gap: 18px;">
      <span class="script" style="font-size: 28px;">¿Te decidiste?</span>
      <h2 class="display" style="font-size: 46px; margin: 0;">Reserva tu mesa</h2>
      <p class="lead" style="max-width: 540px; margin: 0;">Abierto de {site.hours.label}. Reserva en línea o llega directo.</p>
      <p class="dim" style="max-width: 700px; margin: 0;">Conoce <a href="/nosotros/" style="color: var(--accent-ink);">quién cocina</a>, mira las opciones de <a href="/eventos/" style="color: var(--accent-ink);">eventos y grupos</a>, <a href="/menu-origen.pdf" style="color: var(--accent-ink);">descarga el menú en PDF</a> o <a href={site.openTable.url.es} target="_blank" rel="noopener" style="color: var(--accent-ink);">reserva directo en OpenTable</a>.</p>
      <OpenTableWidget theme="wide" lang="es" />
    </div>
  </section>
</Base>
