---
import QRCode from 'qrcode';
import { site } from '../data/site';
import { isReal } from '../data/placeholders';
import { qrStrings, type QrLang } from '../data/i18n/qr';
import '../styles/global.css';

// Pantalla interna de reseñas (/qr/): invita al cliente a dejar su reseña en
// Google y TripAdvisor. No enlazada desde el sitio, noindex y fuera del sitemap.
// Es data-driven: al confirmar el cliente nuevos enlaces en `site.ts`, sus tarjetas
// aparecen y este test lo valida sin cambios.
// Bilingüe en una sola URL: un interruptor ES/EN cambia el copy sin navegar a otra URL.
// Los textos EN viven en data-en attributes; el JS los intercambia al hacer clic.

const es = qrStrings.es;
const en = qrStrings.en;

const googleLogo = `
  <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
    <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
    <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
    <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
  </svg>`;

const tripadvisorLogo = `
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="#00AA6C" d="M12.006 4.295c-2.67 0-5.338.784-7.645 2.353H0l1.963 2.135a5.997 5.997 0 0 0 4.04 10.43 5.976 5.976 0 0 0 4.075-1.6L12 19.705l1.922-2.09a5.972 5.972 0 0 0 4.072 1.598 6 6 0 0 0 6-5.998 5.982 5.982 0 0 0-1.957-4.432L24 6.648h-4.35a13.573 13.573 0 0 0-7.644-2.353zM12 6.255c1.531 0 3.063.303 4.504.903C13.943 8.138 12 10.43 12 13.1c0-2.671-1.942-4.962-4.504-5.942A11.72 11.72 0 0 1 12 6.256zM6.002 9.157a4.059 4.059 0 1 1 0 8.118 4.059 4.059 0 0 1 0-8.118zm11.992.002a4.057 4.057 0 1 1 .003 8.115 4.057 4.057 0 0 1-.003-8.115zm-11.992 1.93a2.128 2.128 0 0 0 0 4.256 2.128 2.128 0 0 0 0-4.256zm11.992 0a2.128 2.128 0 0 0 0 4.256 2.128 2.128 0 0 0 0-4.256z"/>
  </svg>`;

const targetDefs = [
  {
    key: 'google',
    labelEs: es.cards[0].label,
    labelEn: en.cards[0].label,
    titleEs: es.cards[0].title,
    titleEn: en.cards[0].title,
    displayEs: es.cards[0].display,
    displayEn: en.cards[0].display,
    noteEs: es.cards[0].note,
    noteEn: en.cards[0].note,
    logo: googleLogo,
    urlKey: 'google' as const,
  },
  {
    key: 'tripadvisor',
    labelEs: es.cards[1].label,
    labelEn: en.cards[1].label,
    titleEs: es.cards[1].title,
    titleEn: en.cards[1].title,
    displayEs: es.cards[1].display,
    displayEn: en.cards[1].display,
    noteEs: es.cards[1].note,
    noteEn: en.cards[1].note,
    logo: tripadvisorLogo,
    urlKey: 'tripadvisor' as const,
  },
];

const opts = {
  type: 'svg' as const,
  margin: 1,
  width: 400,
  errorCorrectionLevel: 'M' as const,
  color: { dark: '#14110D', light: '#FFFFFF' },
};

const cards = await Promise.all(
  targetDefs.filter((t) => isReal(site.reviewUrl[t.urlKey])).map(async (t) => ({ ...t, svg: await QRCode.toString(site.reviewUrl[t.urlKey], opts) })),
);
const pending = targetDefs.filter((t) => !isReal(site.reviewUrl[t.urlKey]));
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#0F0E0C" />
  <title data-es={es.htmlTitle} data-en={en.htmlTitle}>{es.htmlTitle}</title>
</head>
<body class="qr-body" data-lang="es">
  <main class="qr">
    <header class="qr-head">
      <img class="qr-logo" src="/logo-origen.png" alt="Origen · Mar, tierra y fuego" width="112" height="112" />
      <div class="qr-lang-toggle" role="group" aria-label="Idioma">
        <button class="qr-lang-btn" data-lang="es" aria-pressed="true">ES</button>
        <button class="qr-lang-btn" data-lang="en">EN</button>
      </div>
      <p class="qr-kicker" data-es={es.kicker} data-en={en.kicker}>{es.kicker}</p>
      <h1 class="qr-title" data-es={es.title} data-en={en.title}>{es.title}</h1>
      <p class="qr-sub" data-es={es.sub} data-en={en.sub}>{es.sub}</p>
    </header>

    <ul class="qr-grid">
      {cards.map((c) => (
        <li class="qr-card" data-qr={c.key}>
          <div class="qr-brand">
            <span class="qr-mark" set:html={c.logo} />
            <span class="qr-brand-name" data-es={c.labelEs} data-en={c.labelEn}>{c.labelEs}</span>
          </div>
          <div class="qr-frame" set:html={c.svg} />
          <div class="qr-copy">
            <h2 class="qr-name" data-es={c.titleEs} data-en={c.titleEn}>{c.titleEs}</h2>
            <p class="qr-note" data-es={c.noteEs} data-en={c.noteEn}>{c.noteEs}</p>
          </div>
          <a class="qr-url" href={c.urlKey === 'google' ? site.reviewUrl.google : site.reviewUrl.tripadvisor} target="_blank" rel="noopener" data-es={c.displayEs} data-en={c.displayEn}>{c.displayEs}</a>
        </li>
      ))}
    </ul>

    {pending.length > 0 && (
      <p class="qr-pending" data-es={es.pending} data-en={en.pending}>{es.pending}</p>
    )}

    <footer class="qr-foot">
      <span data-es={es.footBrand} data-en={en.footBrand}>{es.footBrand}</span>
      <span aria-hidden="true">·</span>
      <span>{es.footPlace}</span>
    </footer>
  </main>

  <style>
    :root { color-scheme: dark; }
    .qr-body {
      min-height: 100vh;
      min-height: 100svh;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: clamp(20px, 4vmin, 48px);
      background:
        radial-gradient(110% 80% at 50% -10%, rgba(217, 132, 74, .13), transparent 58%),
        radial-gradient(90% 70% at 50% 115%, rgba(217, 132, 74, .07), transparent 62%),
        var(--bg);
      overflow-x: hidden;
    }
    /* Marco editorial fino, como una carta impresa. */
    .qr-body::before {
      content: '';
      position: fixed;
      inset: clamp(10px, 1.6vmin, 18px);
      border: 1px solid rgba(242, 235, 221, .10);
      pointer-events: none;
    }
    main.qr {
      --qr: clamp(210px, 28vmin, 320px);
      width: min(980px, 100%);
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(22px, 3.6vh, 40px);
    }
    .qr-head {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 6px;
    }
    .qr-logo {
      height: clamp(62px, 10vh, 104px);
      width: auto;
      margin-bottom: clamp(4px, 1vh, 10px);
    }
    .qr-kicker {
      font-family: var(--serif);
      font-style: italic;
      font-weight: 500;
      font-size: clamp(22px, 3.4vmin, 32px);
      line-height: 1;
      color: var(--accent);
    }
    .qr-title {
      font-family: var(--sans);
      font-weight: 500;
      letter-spacing: .2em;
      text-transform: uppercase;
      font-size: clamp(26px, 4.4vmin, 44px);
      line-height: 1.1;
    }
    .qr-sub {
      font-size: clamp(10px, 1.5vmin, 13px);
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .qr-grid {
      list-style: none;
      margin: 0;
      padding: 0;
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(16px, 2.4vw, 30px);
    }
    .qr-card {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(10px, 1.6vmin, 18px);
      padding: clamp(18px, 2.8vmin, 32px);
      background: linear-gradient(180deg, var(--cream-card), #F4ECDF);
      color: var(--ink);
      border: 1px solid rgba(217, 132, 74, .32);
      border-radius: 3px;
      box-shadow: 0 30px 70px -52px rgba(0, 0, 0, .95);
    }
    .qr-card::before {
      content: '';
      position: absolute;
      inset: 8px 8px auto;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(154, 79, 30, .28), transparent);
    }
    .qr-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      min-height: 26px;
    }
    .qr-mark { display: inline-flex; width: 24px; height: 24px; }
    .qr-mark :global(svg) { width: 100%; height: 100%; display: block; }
    .qr-brand-name {
      font-size: 11px;
      font-weight: 500;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--ink-muted);
    }
    .qr-frame {
      width: min(100%, var(--qr));
      aspect-ratio: 1;
      padding: clamp(8px, 1.1vmin, 12px);
      background: #fff;
      border: 1px solid #E5D9C7;
    }
    .qr-frame :global(svg) { width: 100%; height: 100%; display: block; }
    .qr-copy {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      text-align: center;
    }
    .qr-name {
      font-family: var(--serif);
      font-weight: 600;
      font-size: clamp(20px, 2.8vmin, 28px);
      line-height: 1.1;
    }
    .qr-note {
      font-size: clamp(12px, 1.6vmin, 14px);
      line-height: 1.45;
      color: var(--ink-muted);
      max-width: 32ch;
    }
    .qr-url {
      min-height: 28px;
      display: inline-flex;
      align-items: center;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: .16em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--accent-ink);
      border-bottom: 1px solid rgba(154, 79, 30, .35);
    }
    .qr-url:hover { color: var(--ink); border-color: var(--ink); }
    .qr-pending {
      text-align: center;
      font-size: 12px;
      letter-spacing: .08em;
      color: var(--dim);
    }
    .qr-foot {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      font-size: 10px;
      letter-spacing: .22em;
      text-transform: uppercase;
      color: var(--dim);
    }

    /* ---- Selector de idioma ---- */
    .qr-lang-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: clamp(6px, 1vh, 12px);
      padding: 6px 10px;
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(242, 235, 221, .18);
      border-radius: 20px;
    }
    .qr-lang-btn {
      background: transparent;
      border: none;
      color: var(--muted);
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      cursor: pointer;
      padding: 4px 10px;
      border-radius: 14px;
      transition: color .2s, background .2s;
    }
    .qr-lang-btn:hover { color: var(--soft); }
    .qr-lang-btn[aria-pressed="true"] {
      color: var(--ink);
      background: var(--cream);
    }
    .qr-lang-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    /* Tablet en horizontal: mantiene las dos tarjetas en una sola pantalla. */
    @media (max-height: 760px) and (min-width: 700px) {
      .qr-body { padding-block: 24px; }
      main.qr { --qr: clamp(180px, 24vmin, 240px); gap: 22px; }
      .qr-logo { height: 62px; margin-bottom: 2px; }
      .qr-title { font-size: clamp(24px, 4vmin, 34px); }
      .qr-card { padding: 20px 24px; gap: 10px; }
      .qr-name { font-size: 22px; }
    }

    /* Móvil: una tarjeta por fila y QR más grande, con scroll natural. */
    @media (max-width: 639px) {
      .qr-body { align-items: flex-start; }
      main.qr { --qr: min(64vw, 280px); }
      .qr-grid { grid-template-columns: 1fr; }
      .qr-logo { height: 72px; }
    }

    @media (prefers-reduced-motion: no-preference) {
      .qr-card { animation: qr-in 700ms var(--ease-out) both; }
      .qr-card:nth-child(2) { animation-delay: 90ms; }
    }
    @keyframes qr-in {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: none; }
    }

    @media print {
      .qr-body { background: #fff; color: #000; padding: 0; }
      .qr-body::before, .qr-foot { display: none; }
      .qr-lang-toggle { display: none; }
      main.qr { --qr: 260px; gap: 24px; }
      .qr-head { gap: 2px; }
      .qr-logo { height: 72px; }
      .qr-kicker { color: #9A4F1E; }
      .qr-sub, .qr-brand-name, .qr-note, .qr-url { color: #333; }
      .qr-card { border: 1px solid #ddd; box-shadow: none; background: #fff; break-inside: avoid; }
    }
  </style>

  <script is:inline>
    (function () {
      const root = document.body;
      const esBtn = document.querySelector('.qr-lang-btn[data-lang="es"]');
      const enBtn = document.querySelector('.qr-lang-btn[data-lang="en"]');
      const titleEl = document.querySelector('title');

      // Todos los nodos con copy traducible llevan data-es y data-en.
      const translatable = document.querySelectorAll('[data-es][data-en]');

      function setLang(lang) {
        root.setAttribute('data-lang', lang);
        esBtn.setAttribute('aria-pressed', lang === 'es');
        enBtn.setAttribute('aria-pressed', lang === 'en');
        const attr = lang === 'es' ? 'data-es' : 'data-en';
        translatable.forEach((node) => {
          const value = node.getAttribute(attr);
          if (value !== null) node.textContent = value;
        });
        document.title = titleEl.getAttribute(attr);
      }

      esBtn.addEventListener('click', () => setLang('es'));
      enBtn.addEventListener('click', () => setLang('en'));
    })();
  </script>
</body>
</html>
