---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
---
<Base
  title="Nosotros · Origen Jacó — Historia, chef y equipo"
  description={`Origen abrió en Jacó en octubre de 2026 en el local del antiguo Hicaco Plaza, con el mismo equipo. Conoce a la chef ${site.chef} y nuestra cocina de mar, tierra y fuego.`}
>
  <PageHero crumb="Nosotros" script="Nuestra" title="Historia" photo="equipo en la cocina" lead="Un restaurante nuevo en Jacó, con un equipo que ya conoces." />

  <section class="light">
    <div class="container section row">
      <div class="stack" style="gap: 18px;">
        <h2 class="display">Del antiguo Hicaco a Origen</h2>
        <p class="lead">Origen abrió en octubre de 2026 en el mismo local donde funcionó Hicaco Plaza Jacó. Mantenemos al mismo equipo de cocina y de salón, la misma calidad y el mismo servicio, con una propuesta renovada.</p>
        <p class="lead">Nuestro nombre lo dice todo: volver al origen de cada ingrediente. Mariscos del Pacífico de proveedores locales, frutas y verduras costarricenses, y la parrilla como protagonista.</p>
        <p class="lead">[Párrafo opcional: anécdota o visión de los dueños]</p>
      </div>
      <Photo label="fachada / salón" height="520px" style="background-color:#2A2520" />
    </div>
  </section>

  <section class="container section row" style="flex-wrap: wrap-reverse;" aria-labelledby="chef-t">
    <Photo label={`retrato chef ${site.chef}`} height="560px" />
    <div class="stack">
      <span class="script">En la cocina</span>
      <h2 id="chef-t" class="display" style="font-size: 52px;">Chef {site.chef}</h2>
      <p class="lead">Jefa de cocina de Origen y la misma chef que estaba al frente de la cocina del restaurante anterior. [Agregar trayectoria, formación y su plato favorito del menú.]</p>
      <blockquote style="margin: 8px 0 0; font-family: var(--serif); font-style: italic; font-size: 28px; line-height: 1.3;">“[Frase real de la chef sobre su cocina]”</blockquote>
    </div>
  </section>

  <section class="dark-2" aria-labelledby="team-t">
    <div class="container section stack" style="gap: 48px;">
      <div class="center" style="gap: 6px;">
        <span class="script">Las personas</span>
        <h2 id="team-t" class="caps" style="font-weight: 500; font-size: 34px;">Nuestro equipo</h2>
      </div>
      <div class="grid" style="--min: 240px; --gap: 24px;">
        {[
          [site.chef, 'Chef ejecutiva', 'foto'],
          [site.manager, 'Gerente general', 'foto'],
          ['Cocina y salón', 'El equipo de siempre', 'foto grupal'],
        ].map(([name, role, photo]) => (
          <div class="stack" style="gap: 12px;">
            <Photo label={photo} height="320px" />
            <h3 style="font-family: var(--serif); font-weight: 600; font-size: 26px;">{name}</h3>
            <span class="label">{role}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container section stack" style="gap: 48px;" aria-labelledby="val-t">
    <h2 id="val-t" class="display" style="text-align: center;">Lo que nos define</h2>
    <div class="grid" style="--min: 260px; --gap: 40px;">
      {[
        ['Mar', 'Pescado y mariscos del Pacífico costarricense, comprados a proveedores locales.'],
        ['Tierra', 'Frutas y verduras de productores de la zona, salsas y bases hechas en casa cada día.'],
        ['Fuego', 'Cortes a la parrilla con chimichurri ahumado y el sabor que solo da la brasa.'],
      ].map(([t, d]) => (
        <div class="stack" style="gap: 10px; border-top: 1px solid var(--accent); padding-top: 24px;">
          <h3 style="font-family: var(--serif); font-weight: 600; font-size: 34px;">{t}</h3>
          <p style="color: var(--soft);">{d}</p>
        </div>
      ))}
    </div>
    <div class="btns">
      <a href="/menu/" class="btn btn-primary">Ver el menú</a>
      <a href="/contacto/#reservar" class="btn btn-ghost">Reservar mesa</a>
    </div>
  </section>
</Base>
