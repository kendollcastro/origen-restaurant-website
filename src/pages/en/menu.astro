---
// T-36: página EN completa (P-22 aprobado). Espejo de /menu/ con el catálogo en inglés.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DishList from '../../components/DishList.astro';
import OpenTableWidget from '../../components/OpenTableWidget.astro';
import { menu } from '../../data/menu';
import { site } from '../../data/site';
import { platos } from '../../data/photos';
import { enPages } from '../../data/i18n/pages';

const p = enPages.menu;

// JSON-LD del menú (solo platos confirmados), en inglés.
const menuSchema = {
  '@context': 'https://schema.org',
  '@type': 'Menu',
  '@id': `${site.url}/en/menu/#menu`,
  name: `Menu of ${site.fullName}`,
  inLanguage: 'en',
  hasMenuSection: menu
    .map((c) => ({
      '@type': 'MenuSection',
      name: c.titleEn ?? c.title,
      hasMenuItem: c.dishes
        .filter((d) => !d.name.startsWith('['))
        .map((d) => ({
          '@type': 'MenuItem',
          name: d.nameEn ?? d.name,
          ...(d.descEn ?? d.desc ? { description: d.descEn ?? d.desc } : {}),
          ...(d.price ? { offers: { '@type': 'Offer', price: d.price, priceCurrency: 'CRC' } } : {}),
        })),
    }))
    .filter((s) => s.hasMenuItem.length),
};
---
<Base title={p.title} description={p.description} lang="en" schema={menuSchema}>
  <PageHero
    crumb={p.h1} script={p.script} title={p.h1} photo="table with a variety of dishes" src={platos[6]}
    lead={p.lead} lang="en"
  />

  <nav class="cat-nav" aria-label="Menu categories">
    <div class="container">
      {menu.map((c) => <a href={`#${c.id}`}>{c.titleEn ?? c.title}</a>)}
    </div>
  </nav>

  <div class="container menu-cats" style="padding-block: 88px 120px;">
    {menu.map((c, i) => (
      <section id={c.id} class="stack reveal" style={`gap: 6px; --reveal-delay:${i * 0.06}s`} aria-labelledby={`h-${c.id}`}>
        <span class="script" style="font-size: 24px;">{c.kickerEn ?? c.kicker}</span>
        <h2 id={`h-${c.id}`} class="display" style="font-size: clamp(32px, 9vw, 46px); margin-bottom: 6px;">{c.titleEn ?? c.title}</h2>
        {c.noteEn && <p class="dim">{c.noteEn}</p>}
        <DishList dishes={c.dishes} lang="en" />
      </section>
    ))}
  </div>

  <section class="light">
    <div class="container center reveal" style="padding-block: 80px 56px; gap: 18px;">
      <span class="script" style="font-size: 28px;">Hungry?</span>
      <h2 class="display" style="font-size: 46px; margin: 0;">Book your table</h2>
      <p class="lead" style="max-width: 540px; margin: 0;">Open {site.hours.label}. Book online or just walk in.</p>
      <p class="dim" style="max-width: 700px; margin: 0;">Meet <a href="/en/nosotros/" style="color: var(--accent-ink);">who cooks</a>, see the <a href="/en/eventos/" style="color: var(--accent-ink);">events and groups</a> options, <a href="/menu-origen.pdf" style="color: var(--accent-ink);">download the menu (PDF)</a> or <a href={site.openTable.url.en} target="_blank" rel="noopener" style="color: var(--accent-ink);">book directly on OpenTable</a>.</p>
      <OpenTableWidget theme="wide" lang="en" />
    </div>
  </section>
</Base>
