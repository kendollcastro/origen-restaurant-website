---
// TODO: traducción aprobada (P-22) — T-36 sustituye el cuerpo EN provisional.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site, waLink } from '../../data/site';
import { enPages } from '../../data/i18n/pages';

const p = enPages.eventos;
const waHref = waLink('Hello Origen, I would like to quote an event.');
---
<Base title={p.title} description={p.description} lang="en">
  <PageHero crumb={p.h1} script={p.script} title={p.h1} photo="mesa larga montada para evento" lead={p.lead}>
    <a href="/en/contacto/#cotizar" class="btn btn-primary" style="margin-top: 12px;">Quote my event</a>
  </PageHero>

  <section class="light">
    <div class="container grid" style="--min: 220px; --gap: 32px; padding-block: 80px; text-align: center;">
      <div class="stack" style="gap: 4px;">
        <span style="font-family: var(--serif); font-weight: 600; font-size: 64px; line-height: 1;">{site.capacity}</span>
        <span class="label" style="color: var(--ink-muted);">guests of capacity</span>
      </div>
    </div>
  </section>

  <section class="container section stack" style="gap: 24px; max-width: 820px;">
    <p class="lead">Birthdays, weddings, company dinners and tour groups at a step from Jacó beach, with a tailor-made menu and a team experienced with groups.</p>
    <div class="btns">
      <a href={waHref} class="btn btn-primary" target="_blank" rel="noopener">Quote on WhatsApp</a>
      <a href="/en/contacto/" class="btn btn-ghost">Contact us</a>
    </div>
  </section>
</Base>