---
// Formulario de reserva que abre WhatsApp con el mensaje armado.
import { site, waLink } from '../data/site';
import type { Lang } from '../data/i18n/ui';
interface Props { variant?: 'bar' | 'card'; id?: string; lang?: Lang; }
const { variant = 'bar', id = 'r', lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const waHref = waLink(isEn ? 'Hello Origen, I would like to book a table.' : 'Hola Origen, quisiera reservar una mesa.');
const t = isEn
  ? { aria: 'Book a table', title: 'Book your table', name: 'Name', guests: 'Guests', date: 'Date', time: 'Time', submit: 'Book on WhatsApp', noscriptPlain: 'Without JavaScript the form is not sent: ', noscriptLink: 'message us on WhatsApp', noscriptAfter: ' with your party size, date and time.' }
  : { aria: 'Reservar mesa', title: 'Reserva tu mesa', name: 'Nombre', guests: 'Personas', date: 'Fecha', time: 'Hora', submit: 'Reservar por WhatsApp', noscriptPlain: 'Sin JavaScript no enviamos el formulario: ', noscriptLink: 'escríbenos por WhatsApp', noscriptAfter: ' indicando personas, fecha y hora.' };
---
<form class={`form reserve-form ${variant === 'card' ? 'card-form' : ''}`} data-wa={site.whatsapp} data-lang={lang} action={waHref} method="get" target="_blank" aria-label={t.aria}>
  {variant === 'card' && <h2 class="display full" style="font-size: 36px;">{t.title}</h2>}
  {variant === 'card' && (
    <div class="field">
      <label for={`${id}-n`}>{t.name}</label>
      <input id={`${id}-n`} name="nombre" type="text" autocomplete="name" required />
    </div>
  )}
  <div class="field">
    <label for={`${id}-p`}>{t.guests}</label>
    <select id={`${id}-p`} name="personas">
      <option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>8</option><option>10+</option>
    </select>
  </div>
  <div class="field">
    <label for={`${id}-d`}>{t.date}</label>
    <input id={`${id}-d`} name="fecha" type="date" required />
  </div>
  <div class="field">
    <label for={`${id}-h`}>{t.time}</label>
    <input id={`${id}-h`} name="hora" type="time" value="19:00" min="11:00" max="21:30" required />
  </div>
  {variant !== 'card' && (
    <div class="field">
      <label for={`${id}-n`}>{t.name}</label>
      <input id={`${id}-n`} name="nombre" type="text" autocomplete="name" required />
    </div>
  )}
  <button type="submit" class={`btn btn-primary ${variant === 'card' ? 'full' : ''}`} style="height: 50px;">
    {t.submit}
  </button>
  <noscript class="full">
    <p class="dim">{t.noscriptPlain}<a href={waHref}>{t.noscriptLink}</a>{t.noscriptAfter}</p>
  </noscript>
</form>

<script>
  const hoyEnCR = () => {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Costa_Rica',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }).formatToParts(new Date());
    const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
    return `${get('year')}-${get('month')}-${get('day')}`;
  };
  document.querySelectorAll<HTMLFormElement>('.reserve-form').forEach((form) => {
    const date = form.querySelector<HTMLInputElement>('input[type="date"]');
    if (date) date.min = hoyEnCR();
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const en = form.dataset.lang === 'en';
      const nombre = d.get('nombre') ? (en ? `I'm ${d.get('nombre')}, ` : `Soy ${d.get('nombre')}, `) : '';
      const msg = en
        ? `Hello Origen, ${nombre}I would like to book a table for ${d.get('personas')} people on ${d.get('fecha')} at ${d.get('hora')}.`
        : `Hola Origen, ${nombre}quisiera reservar una mesa para ${d.get('personas')} personas el ${d.get('fecha')} a las ${d.get('hora')}.`;
      window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
    });
  });
</script>
