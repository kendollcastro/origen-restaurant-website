---
// Placeholder de foto. Cuando tengas la imagen, pasa `src` y `alt` y se muestra la foto.
// Recomendado: guardar fotos en src/assets y migrar a <Image /> de astro:assets.
interface Props {
  label: string;
  src?: string;
  alt?: string;
  height?: string;
  class?: string;
  style?: string;
}
const { label, src, alt = '', height, class: cls = '', style = '' } = Astro.props;
---
<div class={`ph ${cls}`} style={`${height ? `height:${height};` : ''}${style}`}>
  {src ? <img src={src} alt={alt} loading="lazy" decoding="async" /> : <span class="ph-label">Foto · {label}</span>}
  <slot />
</div>
