---
// Placeholder de foto. Cuando tengas la imagen, pasa `src` y `alt` y se muestra la foto.
// Sin `src` se reserva el bloque (textura) pero sin texto de placeholder: política §6.
// El bloque es CSS/fondo: el rol y la información los aporta el `<slot>` visible (h1, artículo…).
// Recomendado: guardar fotos en src/assets y migrar a <Image /> de astro:assets.
interface Props {
  label: string;
  src?: string;
  alt?: string;
  height?: string;
  class?: string;
  style?: string;
}
// T-42: ninguna <img> real puede salir sin texto alternativo. `alt` explícito manda;
// si la página no lo pasa, se usa `label` (descriptor de la toma). Un `alt=""` explícito
// sigue siendo válido para imágenes decorativas (GLOSARIO §7). T-26 afinará alt/loading.
const { label, src, alt, height, class: cls = '', style = '' } = Astro.props;
const imgAlt = alt ?? label;
---
<div class={`ph ${cls}`} style={`${height ? `height:${height};` : ''}${style}`}>
  {src && <img src={src} alt={imgAlt} loading="lazy" decoding="async" />}
  <slot />
</div>
