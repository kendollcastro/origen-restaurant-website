---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Foto con placeholder de reserva (política §6). Con `src` (asset de astro:assets)
// emite <Picture> optimizado (AVIF/WebP + srcset/sizes) y previene CLS con el ratio
// del contenedor. Sin `src` reserva el bloque textura y muestra el <slot>.
interface Props {
  label: string;
  src?: ImageMetadata | string;
  alt?: string;
  height?: string;
  class?: string;
  style?: string;
  /** Héroe: `loading="eager"` + `fetchpriority="high"` (solo el LCP). */
  priority?: boolean;
  sizes?: string;
  widths?: number[];
}
const {
  label,
  src,
  alt,
  height,
  class: cls = '',
  style = '',
  priority = false,
  sizes = '100vw',
  widths = [320, 480, 640],
} = Astro.props;

// `alt` explícito manda; si no, el descriptor de la toma. `alt=""` = decorativa (GLOSARIO §7).
const imgAlt = alt ?? label;
const asset = src && typeof src === 'object' ? src : null;
const stringSrc = typeof src === 'string' ? src : undefined;
const hasOverlay = Astro.slots.has('default');
const load = priority ? 'eager' : 'lazy';
const fetchpriority = priority ? 'high' : 'auto';
---
<div class={`ph ${cls}`} style={`${height ? `height:${height};` : ''}${style}`}>
  {asset ? (
    <>
      <Picture
        src={asset}
        alt={imgAlt}
        class={priority ? undefined : 'ph-img'}
        formats={['avif', 'webp']}
        widths={widths}
        sizes={sizes}
        loading={load}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={fetchpriority}
      />
      {hasOverlay && <span class="ph-scrim" aria-hidden="true"></span>}
    </>
  ) : stringSrc ? (
    <img src={stringSrc} alt={imgAlt} class={priority ? undefined : 'ph-img'} loading={load} decoding="async" fetchpriority={fetchpriority} />
  ) : null}
  <slot />
</div>
