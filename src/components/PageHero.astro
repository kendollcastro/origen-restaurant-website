---
import Photo from './Photo.astro';
import type { ImageMetadata } from 'astro';
interface Props { crumb: string; script: string; title: string; lead?: string; photo: string; src?: ImageMetadata; caps?: boolean; }
const { crumb, script, title, lead, photo, src, caps = true } = Astro.props;
---
<Photo label={photo} src={src} class="hero hero-sm" sizes="(min-width: 900px) 100vw, 100vw" widths={[480, 640, 800, 1024, 1440]}>
  <div class="inner overlay reveal">
    <nav class="breadcrumb" aria-label="Ruta de navegación"><a href="/">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">{crumb}</span></nav>
    <span class="script script-lg">{script}</span>
    <h1 class={caps ? 'caps' : 'display'} style={caps ? 'font-size: clamp(36px, 6vw, 64px);' : ''}>{title}</h1>
    {lead && <p class="lead" style="max-width: 640px;">{lead}</p>}
    <slot />
  </div>
</Photo>
