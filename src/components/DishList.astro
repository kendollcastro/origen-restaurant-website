---
import { formatPrice, hasDish, type Dish } from '../data/menu';
interface Props { dishes: Dish[]; headingTag?: 'h3' | 'span'; }
const { dishes, headingTag = 'h3' } = Astro.props;
const Tag = headingTag;
const visible = dishes.filter(hasDish);
---
{visible.length > 0 && (
  <ul class="dishes">
    {visible.map((d) => (
      <li class="dish">
        <div class="dish-head">
          <Tag class="dish-name">{d.name}</Tag>
          {d.price ? (
            <>
              <span class="dish-dots" aria-hidden="true"></span>
              <span class="dish-price">{formatPrice(d.price)}</span>
            </>
          ) : null}
        </div>
        {d.desc && <p class="dish-desc">{d.desc}</p>}
      </li>
    ))}
  </ul>
)}
