---
import { site, telHref } from '../data/site';
import { isReal } from '../data/placeholders';
import { getUi, type Lang } from '../data/i18n/ui';
interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const ui = getUi(lang);
const year = new Date().getFullYear();
const hasSocial = isReal(site.social.instagram) || isReal(site.social.facebook) || isReal(site.social.tripadvisor);
---
<footer class="site-footer">
  <div class="container" style="padding-top: 88px;">
    <div class="grid" style="--min: 220px; --gap: 40px;">
      <div class="stack" style="gap: 12px;">
        <span class="logo"><b>ORIGEN</b><small>{site.tagline}</small></span>
        {hasSocial && (
          <div class="social">
            {isReal(site.social.instagram) && (
              <a href={site.social.instagram} aria-label="Instagram" rel="noopener" target="_blank">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" /></svg>
              </a>
            )}
            {isReal(site.social.facebook) && (
              <a href={site.social.facebook} aria-label="Facebook" rel="noopener" target="_blank">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z" /></svg>
              </a>
            )}
            {isReal(site.social.tripadvisor) && (
              <a href={site.social.tripadvisor} aria-label="TripAdvisor" rel="noopener" target="_blank">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="7" cy="13" r="4" /><circle cx="17" cy="13" r="4" /><path d="M3 9c5-3 13-3 18 0" /></svg>
              </a>
            )}
          </div>
        )}
      </div>
      <address class="stack" style="font-style: normal; gap: 4px;">
        <h2>{ui.footer.visit}</h2>
        <p>{isReal(site.address.street) && <>{site.address.street}<br /></>}{site.address.locality}, {site.address.county}, {site.address.region}<br />{site.address.countryName}</p>
      </address>
      <div class="stack" style="gap: 4px;">
        <h2>{ui.footer.hours}</h2>
        <p>{lang === 'en' ? site.hours.daysEn : site.hours.days}<br />{site.hours.label}</p>
      </div>
      <div class="stack" style="gap: 4px;">
        <h2>{ui.footer.contact}</h2>
        <p>
          <a href={telHref(site.phone)} style="color: var(--soft);">{site.phone}</a><br />
          <a href={`https://wa.me/${site.whatsapp}`} style="color: var(--soft);">WhatsApp</a><br />
          <a href={`mailto:${site.email}`} style="color: var(--soft);">{site.email}</a>
        </p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} {site.fullName} · Jacó, Costa Rica</span>
      <nav aria-label={ui.footerNavAria}>
        {ui.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
  </div>
</footer>
