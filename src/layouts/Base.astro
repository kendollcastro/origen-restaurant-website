---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { isReal } from '../data/placeholders';
import { getUi, type Lang } from '../data/i18n/ui';

interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: object | object[]; // JSON-LD extra por página
  lang?: Lang; // idioma de la página: es (default) | en
}

const { title, description = site.description, image = '/og-image.jpg', schema, lang = 'es' } = Astro.props;
const ui = getUi(lang);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogLocale = lang === 'en' ? 'en_US' : 'es_CR';
// Las páginas /en/ aún no están traducidas ni aprobadas (P-22 → T-36). No indexar
// hasta go-live: T-38 emitirá hreflang/indexación, y el sitemap las excluye (astro.config.mjs).
const robotsNoIndex = lang === 'en';
const ogImage = new URL(image, Astro.site ?? site.url).href;

// JSON-LD base del restaurante (va en todas las páginas).
// Campos con dato pendiente del cliente se omiten: política §6 (ocultar > inventar).
const sameAs = Object.values(site.social).filter(isReal);
const restaurant = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${site.url}/#restaurant`,
  name: site.fullName,
  alternateName: 'Origen Jacó',
  description: site.description,
  url: site.url,
  ...(isReal(site.phone) && !site.phone.includes('0000') ? { telephone: site.phone } : {}),
  ...(isReal(site.email) ? { email: site.email } : {}),
  // image: se emite en T-27 cuando exista og-image.jpg (hoy pendiente P-17).
  servesCuisine: ['Mariscos', 'Parrilla', 'Costarricense'],
  priceRange: site.priceRange,
  acceptsReservations: true,
  maximumAttendeeCapacity: site.capacity,
  hasMenu: `${site.url}/menu/`,
  address: {
    '@type': 'PostalAddress',
    // streetAddress: se omite mientras site.address.street siga pendiente (P-02);
    // se conservan localidad/región/país reales (GLOSARIO §6, mapa/ubicación).
    ...(isReal(site.address.street) ? { streetAddress: site.address.street } : {}),
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: site.hours.schema,
    opens: site.hours.opens,
    closes: site.hours.closes,
  }],
  ...(sameAs.length > 0 ? { sameAs } : {}),
};
const ld = [restaurant, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {robotsNoIndex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Cuando exista la versión en inglés (/en/...), activar: -->
  <!-- <link rel="alternate" hreflang="es" href={canonical} /> -->
  <!-- <link rel="alternate" hreflang="en" href={canonical.replace(site.url, site.url + '/en')} /> -->
  <meta name="theme-color" content="#0F0E0C" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.fullName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Jost:wght@300;400;500;600&display=swap" />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
  <a href="#contenido" class="sr-only skip-link">{ui.skipLink}</a>
  <Header lang={lang} />
  <main id="contenido" tabindex="-1">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
