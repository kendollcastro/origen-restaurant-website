---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, nav } from '../data/site';
import { isReal } from '../data/placeholders';
import { getUi, type Lang } from '../data/i18n/ui';

interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: object | object[]; // JSON-LD extra por página
  lang?: Lang; // idioma de la página: es (default) | en
}

const { title, description = site.description, image = '/og-image.jpg', schema, lang = 'es' } = Astro.props;
const ui = getUi(lang);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogLocale = lang === 'en' ? 'en_US' : 'es_CR';
// Las páginas /en/ aún no están traducidas ni aprobadas (P-22 → T-36). No indexar
// hasta go-live: T-38 emitirá hreflang/indexación, y el sitemap las excluye (astro.config.mjs).
const robotsNoIndex = lang === 'en';
const ogImage = new URL(image, Astro.site ?? site.url).href;

// JSON-LD base del restaurante (va en todas las páginas).
// Campos con dato pendiente del cliente se omiten: política §6 (ocultar > inventar).
const sameAs = Object.values(site.social).filter(isReal);
// Personas reales (site.ts). Solo campos seguros: sin image/url inventados (P-16/P-17).
// `jobTitle` replica literal la etiqueta visible del equipo en /nosotros/ (T-15).
const employees = [
  { '@type': 'Person', '@id': `${site.url}/nosotros/#chef`, name: site.chef, jobTitle: 'Chef ejecutiva' },
  { '@type': 'Person', '@id': `${site.url}/nosotros/#manager`, name: site.manager, jobTitle: 'Gerente general' },
].filter((p) => isReal(p.name));
const restaurant = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${site.url}/#restaurant`,
  name: site.fullName,
  alternateName: 'Origen Jacó',
  description: site.description,
  url: site.url,
  ...(isReal(site.phone) && !site.phone.includes('0000') ? { telephone: site.phone } : {}),
  ...(isReal(site.email) ? { email: site.email } : {}),
  // image: se emite en T-27 cuando exista og-image.jpg (hoy pendiente P-17). No se inventa.
  servesCuisine: ['Mariscos', 'Parrilla', 'Costarricense'],
  priceRange: site.priceRange,
  acceptsReservations: true,
  hasMenu: `${site.url}/menu/`,
  ...(employees.length > 0 ? { employee: employees } : {}),
  // maximumAttendeeCapacity (heredada de Place/Event) NO es propiedad de Restaurant para
  // rich results de Google y el PLAN la marca como incorrecta en Base.astro:33 → se retira.
  // La capacidad (120 invitados) sigue solo en el texto visible (index/eventos/FAQ).
  address: {
    '@type': 'PostalAddress',
    // streetAddress: se omite mientras site.address.street siga pendiente (P-02);
    // se conservan localidad/región/país reales (GLOSARIO §6, mapa/ubicación).
    ...(isReal(site.address.street) ? { streetAddress: site.address.street } : {}),
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  // Horario multiday: un único OpeningHoursSpecification con `dayOfWeek` como array
  // (forma correcta; NO un objeto por día). 1:1 con "Todos los días · 11:00 am – 10:00 pm".
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: site.hours.schema,
    opens: site.hours.opens,
    closes: site.hours.closes,
  }],
  ...(sameAs.length > 0 ? { sameAs } : {}),
  // ReserveAction anclada al CTA visible "Reservar mesa" → /contacto/#reservar (texto 1:1).
  potentialAction: {
    '@type': 'ReserveAction',
    name: 'Reservar mesa',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${site.url}/contacto/#reservar`,
      inLanguage: 'es-CR',
    },
  },
};
// BreadcrumbList solo donde el navegador de migas es visible (PageHero/contacto, T-15):
// menú, nosotros, eventos y contacto. En / e índices (404, /en/*) no hay migas visibles.
const crumbLabel = nav.find((n) => n.href === Astro.url.pathname)?.label;
const breadcrumb =
  lang === 'es' && crumbLabel && Astro.url.pathname !== '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
          { '@type': 'ListItem', position: 2, name: crumbLabel, item: `${site.url}${Astro.url.pathname}` },
        ],
      }
    : undefined;
const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const ld = [restaurant, ...(breadcrumb ? [breadcrumb] : []), ...extra];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {robotsNoIndex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <!-- Cuando exista la versión en inglés (/en/...), activar: -->
  <!-- <link rel="alternate" hreflang="es" href={canonical} /> -->
  <!-- <link rel="alternate" hreflang="en" href={canonical.replace(site.url, site.url + '/en')} /> -->
  <meta name="theme-color" content="#0F0E0C" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.fullName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Jost:wght@300;400;500;600&display=swap" />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
  <a href="#contenido" class="sr-only skip-link">{ui.skipLink}</a>
  <Header lang={lang} />
  <main id="contenido" tabindex="-1">
    <slot />
  </main>
  <Footer lang={lang} />
</body>
</html>
