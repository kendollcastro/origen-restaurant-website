---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, nav } from '../data/site';
import { isReal, isRealPhone } from '../data/placeholders';
import { getUi, type Lang } from '../data/i18n/ui';
import { ROUTES } from '../data/i18n/routes';

interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: object | object[]; // JSON-LD extra por página
  lang?: Lang; // idioma de la página: es (default) | en
}

const { title, description = site.description, image = '/og-image.jpg', schema, lang = 'es' } = Astro.props;
const ui = getUi(lang);
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogLocale = lang === 'en' ? 'en_US' : 'es_CR';
// T-38 (go-live 2026-10-20): /en/ se indexa y se emiten pares hreflang recíprocos.
// Solo para las rutas mapeadas en ROUTES (404 y páginas fuera del mapa no declaran alternate).
const pair = ROUTES.find((r) => r.es === Astro.url.pathname || r.en === Astro.url.pathname);
const alternate = (path: string) => new URL(path, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;

// JSON-LD base del restaurante (va en todas las páginas).
// Campos con dato pendiente del cliente se omiten: política §6 (ocultar > inventar).
const sameAs = Object.values(site.social).filter(isReal);
// Personas reales (site.ts). Solo campos seguros: sin image/url inventados (P-16/P-17).
// `jobTitle` replica literal la etiqueta visible del equipo en /nosotros/ (T-15).
const employees = [
  { '@type': 'Person', '@id': `${site.url}/nosotros/#chef`, name: site.chef, jobTitle: lang === 'en' ? 'Executive chef' : 'Chef ejecutiva' },
  { '@type': 'Person', '@id': `${site.url}/nosotros/#manager`, name: site.manager, jobTitle: lang === 'en' ? 'General manager' : 'Gerente general' },
].filter((p) => isReal(p.name));
// Valores del JSON-LD que dependen del idioma (T-36): el nodo base se emite en cada página con el copy correcto.
const prefix = lang === 'en' ? '/en' : '';
const restaurant = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  '@id': `${site.url}/#restaurant`,
  name: site.fullName,
  alternateName: 'Origen Jacó',
  description: lang === 'en' ? site.descriptionEn : site.description,
  url: site.url,
  ...(isRealPhone(site.phone) ? { telephone: site.phone } : {}),
  ...(isReal(site.email) ? { email: site.email } : {}),
  // og-image provisional (T-27, P-17): se emite ya que public/og-image.jpg responde 200.
  image: [ogImage],
  logo: `${site.url}/logo-origen.png`, // emblema del restaurante (P-16, 2026-10-13)
  servesCuisine: lang === 'en' ? ['Seafood', 'Grill', 'Costa Rican'] : ['Mariscos', 'Parrilla', 'Costarricense'],
  priceRange: site.priceRange,
  acceptsReservations: true,
  hasMenu: `${site.url}${prefix}/menu/`,
  ...(employees.length > 0 ? { employee: employees } : {}),
  // maximumAttendeeCapacity (heredada de Place/Event) NO es propiedad de Restaurant para
  // rich results de Google y el PLAN la marca como incorrecta en Base.astro:33 → se retira.
  // La capacidad (120 invitados) sigue solo en el texto visible (index/eventos/FAQ).
  address: {
    '@type': 'PostalAddress',
    // streetAddress: se omite mientras site.address.street siga pendiente (P-02);
    // se conservan localidad/región/país reales (GLOSARIO §6, mapa/ubicación).
    ...(isReal(site.address.street) ? { streetAddress: site.address.street } : {}),
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  // Horario multiday: un único OpeningHoursSpecification con `dayOfWeek` como array
  // (forma correcta; NO un objeto por día). 1:1 con "Todos los días · 11:00 am – 10:00 pm".
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: site.hours.schema,
    opens: site.hours.opens,
    closes: site.hours.closes,
  }],
  ...(sameAs.length > 0 ? { sameAs } : {}),
  // ReserveAction anclada al CTA visible ("Reservar mesa" / "Book a table") → /contacto/#reservar (texto 1:1).
  potentialAction: {
    '@type': 'ReserveAction',
    name: lang === 'en' ? 'Book a table' : 'Reservar mesa',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${site.url}${prefix}/contacto/#reservar`,
      inLanguage: lang === 'en' ? 'en' : 'es-CR',
    },
  },
};
// BreadcrumbList solo donde el navegador de migas es visible (PageHero/contacto, T-15):
// menú, nosotros, eventos y contacto. En / e índices (404, /en/*) no hay migas visibles.
const crumbLabel = nav.find((n) => n.href === Astro.url.pathname)?.label;
const breadcrumb =
  lang === 'es' && crumbLabel && Astro.url.pathname !== '/'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site.url}/` },
          { '@type': 'ListItem', position: 2, name: crumbLabel, item: `${site.url}${Astro.url.pathname}` },
        ],
      }
    : undefined;
const extra = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const ld = [restaurant, ...(breadcrumb ? [breadcrumb] : []), ...extra];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {pair && (
    <>
      <link rel="alternate" hreflang="es" href={alternate(pair.es)} />
      <link rel="alternate" hreflang="en" href={alternate(pair.en)} />
      <link rel="alternate" hreflang="x-default" href={alternate(pair.es)} />
    </>
  )}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#0F0E0C" />
  <meta name="google-site-verification" content="C8jRrAHtgHak5nGBQkZF-IY2lJfRPPux2vaGhmzDbSs" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.fullName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={lang === 'en' ? 'Origen — sea, land and fire in Jacó, Costa Rica.' : 'Origen — mar, tierra y fuego en Jacó, Costa Rica.'} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={lang === 'en' ? 'es_CR' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-600.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/jost-400.woff2" crossorigin />

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />

  <!-- Google Tag Manager -->
  <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-KNJRKZCN"></script>
  <script>
    (() => {
      const w = window as unknown as {
        dataLayer: unknown[];
        gtag?: (...args: unknown[]) => void;
      };
      w.dataLayer = w.dataLayer || [];
      if (typeof w.gtag !== 'function') {
        w.gtag = (...args: unknown[]) => w.dataLayer.push(args);
      }
      w.gtag?.('js', new Date());
    })();
  </script>
  <!-- Fin Google Tag Manager -->
</head>
<body>
  <a href="#contenido" class="sr-only skip-link">{ui.skipLink}</a>
  <Header lang={lang} />
  <main id="contenido" tabindex="-1">
    <slot />
  </main>
  <Footer lang={lang} />
  <script>
    // Reveal al scroll (progressive enhancement). Se dispara una sola vez por elemento.
    const reveals = document.querySelectorAll<HTMLElement>('.reveal');
    if (reveals.length > 0 && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.setAttribute('data-visible', '');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
      );
      reveals.forEach((el) => io.observe(el));
    }

    // Reservas · OpenTable: el loader (script de terceros) se inyecta solo cuando el
    // widget está a ~600 px del viewport, para no penalizar LCP/TBT. Sin JS queda el
    // enlace directo de respaldo que renderiza el componente.
    const otWidgets = document.querySelectorAll<HTMLElement>('[data-ot-src]');
    if (otWidgets.length > 0) {
      const loadWidget = (el: HTMLElement) => {
        if (el.dataset.otLoaded || !el.dataset.otSrc) return;
        el.dataset.otLoaded = '1';
        const loader = document.createElement('script');
        loader.src = el.dataset.otSrc;
        loader.async = true;
        el.appendChild(loader);
        // El iframe de OpenTable no trae `title`: se lo añadimos al insertarse (axe frame-title).
        const label = el.dataset.otLabel ?? 'OpenTable';
        const nameFrames = () =>
          el.querySelectorAll('iframe').forEach((frame) => {
            if (!frame.title) frame.title = label;
          });
        nameFrames();
        new MutationObserver(nameFrames).observe(el, { childList: true, subtree: true });
      };
      if ('IntersectionObserver' in window) {
        const otObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                otObserver.unobserve(entry.target);
                loadWidget(entry.target as HTMLElement);
              }
            }
          },
          { rootMargin: '600px 0px' },
        );
        otWidgets.forEach((el) => otObserver.observe(el));
      } else {
        otWidgets.forEach(loadWidget);
      }
    }

    // PX-15 · Fade-in de imágenes al cargar (evita el "pop" desde el placeholder).
    document.querySelectorAll<HTMLImageElement>('.ph-img').forEach((img) => {
      const done = () => img.classList.add('is-loaded');
      if (img.complete) done();
      else {
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
      }
    });

    // PX-16 · El mapa revela el skeleton solo cuando entra en pantalla y lo detiene
    // al cargar el iframe (así el shimmer no consume main thread si no se ve).
    document.querySelectorAll<HTMLElement>('.map-frame').forEach((frame) => {
      const iframe = frame.querySelector('iframe');
      let started = false;
      const start = () => {
        if (started || frame.classList.contains('is-loaded')) return;
        started = true;
        frame.classList.add('is-loading');
        window.setTimeout(() => frame.classList.remove('is-loading'), 12000);
      };
      iframe?.addEventListener(
        'load',
        () => {
          frame.classList.remove('is-loading');
          frame.classList.add('is-loaded');
        },
        { once: true },
      );
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                start();
                io.disconnect();
              }
            }
          },
          { rootMargin: '200px' },
        );
        io.observe(frame);
      }
    });
  </script>
</body>
</html>
