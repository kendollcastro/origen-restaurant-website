{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/og-image.jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/menu-origen.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/(.*\\.(?:jpe?g|webp|png|ico|svg))$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/fonts/(.*)\\.woff2$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data: https://www.opentable.com https://cdn.otstatic.com; script-src 'self' 'unsafe-inline' https://www.opentable.com https://cdn.otstatic.com https://ds-aksb-a.akamaihd.net; style-src 'self' 'unsafe-inline'; font-src 'self' https://cdn.otstatic.com; connect-src 'self' https://www.opentable.com https://cdn.otstatic.com https://ds-aksb-a.akamaihd.net; frame-src 'self' https://www.google.com https://www.opentable.com; form-action 'self' https://wa.me; frame-ancestors 'none'"
        }
      ]
    }
  ]
}